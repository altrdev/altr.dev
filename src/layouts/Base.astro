---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  print?: boolean;
}
const { title = site.title, description = site.description, path = '/', print = false } = Astro.props;
const canonical = new URL(path, site.url).href;
const image = new URL('/images/og.png', site.url).href;
---
<!doctype html>
<html lang="en" data-print={print ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Alessandro Travi" />
    <meta name="robots" content={print ? 'noindex, follow' : 'index, follow'} />
    <meta name="color-scheme" content={print ? 'light' : 'light dark'} />
    <meta name="theme-color" content="#0EB57D" />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" sizes="152x152" href="/images/icons/touch-icon-ipad.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/icons/touch-icon-iphone-retina.png" />
    <link rel="apple-touch-icon" sizes="167x167" href="/images/icons/touch-icon-ipad-retina.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Alessandro Travi, Software Engineer – altr.dev" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <meta name="yandex-verification" content="c5acf8bbe12bc1d5" />
    <meta name="msvalidate.01" content="D5D6C71B573ADD7743E2BFEF1E56E6D9" />

  </head>
  <body>
    <slot />
    {/* not on /pdf: it is also rendered by headless Chrome at build time */}
    {!print && <Analytics />}
    {!print && <SpeedInsights />}
  </body>
</html>
